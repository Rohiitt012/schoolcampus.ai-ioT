# Smart School & Smart Campus IoT Backend Environment Template
PORT=5000

# PostgreSQL Database Connection String
# Managed Providers (Neon, Supabase, Railway, AWS RDS, or local PostgreSQL):
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_school_db?schema=public"

# JWT Authentication Secret Key
JWT_SECRET="smart_school_iot_jwt_super_secret_key_2026"

# Google Gemini API Key (Optional for AI Operations Assistant)
GEMINI_API_KEY="your_gemini_api_key_here"

# Frontend Application Origin URL
FRONTEND_URL="http://localhost:3000"
